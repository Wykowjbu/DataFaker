<UserControl x:Class="DataFaker.Views.PageControl.TabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DataFaker.Views.PageControl"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!--FilterControl-->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!--Is Dispaly Filter Button-->
            <ui:Button Grid.Row="0"
                       Command="{Binding FilterCommand}"
                       Margin="10,10,0,0">
                <ui:SymbolIcon Symbol="Filter24"/>
            </ui:Button>
            <!--Filter-->
            <Grid Grid.Row="1"
                  Visibility="{Binding IsDisplayFilter, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <ui:TextBox Width="200"
                                PlaceholderText="Enter filter text..."
                                FontWeight="SemiBold"
                                Text="{Binding FilterText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                    <ui:Button Content="Apply Filter"
                               Command="{Binding ApplyFilterCommand}"
                               Margin="10,0,0,0"
                               Appearance="Primary"/>
                </StackPanel>

            </Grid>
        </Grid>
        
        <!--ContentControl-->
        <Grid Grid.Row="1">
            <ui:DataGrid ItemsSource="{Binding Columns}"
                         AutoGenerateColumns="True"
                         IsReadOnly="True"
                         Margin="10"/>
        </Grid>
    </Grid>
</UserControl>
