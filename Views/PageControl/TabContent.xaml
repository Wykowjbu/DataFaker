<UserControl x:Class="DataFaker.Views.PageControl.TabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DataFaker.Views.PageControl"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--FilterControl-->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!--Is Dispaly Filter Button-->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal">
                <ui:Button Command="{Binding FilterCommand}"
                           ToolTip="Ctrl+Window+F"
                           Margin="10,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Filter Columns" 
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <ui:SymbolIcon Margin="10,0,0,0"
                                       Symbol="Filter24" 
                                       HorizontalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button Command="{Binding CopyToClipboardCommand}"
                           Margin="10,10,0,0"
                           ToolTip="Ctrl+C">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Copy To Clipboard" 
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <ui:SymbolIcon Margin="10,0,0,0"
                                       Symbol="Copy24" 
                                       HorizontalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button Command="{Binding GenDataCommand}"
                           ToolTip="Ctrl+N"
                           Margin="10,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Async Data" 
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <ui:SymbolIcon Margin="10,0,0,0"
                                       Symbol="ArrowSync24" 
                                       HorizontalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>

            </StackPanel>
            <!--Filter-->
            <Grid Grid.Row="1"
                  Visibility="{Binding IsDisplayFilter, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <ui:TextBox Width="200"
                                PlaceholderText="Enter filter text..."
                                FontWeight="SemiBold"
                                Text="{Binding FilterText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                    <ui:Button Content="{Binding ApplyOrReset}"
                               Command="{Binding ApplyCommand}"
                               Margin="10,0,0,0"
                               Appearance="Primary"/>
                </StackPanel>

            </Grid>
        </Grid>

        <!--ContentControl-->
        <Grid Grid.Row="1">
            <ui:DataGrid ItemsSource="{Binding ColumnsPluss}"
             AutoGenerateColumns="False"
             CanUserAddRows="False"
             SelectionMode="Single"
             Margin="10">
                <ui:DataGrid.Columns>

                    <DataGridTemplateColumn Header="Is Lock" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:ToggleSwitch IsChecked="{Binding IsLocked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="IsNotNull" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:ToggleSwitch IsChecked="{Binding IsNotNullable, Mode=OneWay}" 
                                     IsEnabled="False"
                                     HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="IsPrimaryKey" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:ToggleSwitch IsChecked="{Binding IsPrimaryKey, Mode=OneWay}" 
                                                 IsEnabled="False"
                                                 HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Column Name" 
                            Binding="{Binding Name}" 
                            IsReadOnly="True" 
                            />

                    <DataGridTextColumn Header="Data Type" 
                            Binding="{Binding DataType}" 
                            IsReadOnly="True" 
                            />

                    <DataGridTextColumn Header="Value" 
                            Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                            />

                </ui:DataGrid.Columns>
            </ui:DataGrid>
        </Grid>
    </Grid>
</UserControl>
