<UserControl x:Class="DataFaker.Views.PageControl.PageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DataFaker.Views.PageControl"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- thanh nav trái -->
                <ColumnDefinition Width="*"/>
                <!-- content phải -->
            </Grid.ColumnDefinitions>
            <!-- Menu trái: ListView Schema + Table -->
            <ui:DataGrid ItemsSource="{Binding Schemas}" Grid.Column="0" SelectedItem="{Binding SelectedSchema, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Schema" Binding="{Binding Name}" />
                </DataGrid.Columns>
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                            <DataGrid MouseDoubleClick="Table_MouseLeftButtonDown"
                                      ItemsSource="{Binding Tables}"
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="None"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                  SelectionMode="Single">
                                <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Name}">
                                    
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
            </ui:DataGrid>
            <Grid Grid.Column="1">
                <local:Tab DataContext="{Binding}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
